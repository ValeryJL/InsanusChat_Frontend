{
  "name": "insanuschat-harness",
  "displayName": "insanus-harnes Agent & Workspace Chat",
  "description": "Extensión nativa de insanus-harnes para Visual Studio Code: trae el chat vivo de este workspace sincronizado en tiempo real con el Agente IA, errores LSP, diffs y ramificación en árbol.",
  "version": "1.5.0",
  "publisher": "insanustech",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "insanus-harnes",
      "properties": {
        "insanuschat.localDaemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "URL del microservicio local insanus-harnes-daemon (se autodetecta desde runtime.json)"
        },
        "insanuschat.webAppUrl": {
          "type": "string",
          "default": "https://harnes.insanustech.com.ar",
          "description": "URL del servidor Cloud / Web de insanus-harnes"
        },
        "insanuschat.autoFocusSidebar": {
          "type": "boolean",
          "default": true,
          "description": "Enfocar automáticamente el chat del workspace al abrir el Editor Vestido"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "insanuschat-sidebar",
          "title": "insanus-harnes Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "insanuschat-sidebar": [
        {
          "type": "webview",
          "id": "insanuschat.agentView",
          "name": "Chat del Workspace"
        }
      ]
    },
    "commands": [
      {
        "command": "insanuschat.focusChat",
        "title": "insanus-harnes: Enfocar Chat del Workspace"
      },
      {
        "command": "insanuschat.openAgentView",
        "title": "insanus-harnes: Abrir Chat en Panel Lateral"
      },
      {
        "command": "insanuschat.sendSelectionToAgent",
        "title": "insanus-harnes: Enviar Selección al Agente"
      },
      {
        "command": "insanuschat.sendDiagnosticsToAgent",
        "title": "insanus-harnes: Enviar Errores LSP del Archivo al Agente"
      }
    ],
    "keybindings": [
      {
        "command": "insanuschat.focusChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "insanuschat.sendSelectionToAgent",
          "group": "navigation"
        },
        {
          "command": "insanuschat.sendDiagnosticsToAgent",
          "group": "navigation"
        }
      ]
    }
  }
}
