  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#64748b", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#34d399" }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#38bdf8" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#e4e4e7" }
    },
    {
      "scope": ["variable.other.property", "support.type.property-name.json"],
      "settings": { "foreground": "#a5f3fc" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#34d399" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#94a3b8" }
    }
  ]
}
